# AutoSense Backend — environment variables
# Copy to .env and fill in your values before starting the backend.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/autosense

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Email alerts (Gmail + App Password recommended) ───────────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to https://myaccount.google.com/apppasswords → generate a 16-char password
# 3. Paste it as SMTP_PASSWORD below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
ALERT_FROM_EMAIL=your@gmail.com
ALERT_EMAIL_RECIPIENT=alerts@example.com

# ── SMS alerts (Twilio) ───────────────────────────────────────────────────────
# Sign up at https://www.twilio.com — trial accounts work fine for testing.
# TWILIO_FROM_NUMBER must be a Twilio-provisioned number (format: +1XXXXXXXXXX).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1234567890
ALERT_SMS_RECIPIENT=+0987654321
