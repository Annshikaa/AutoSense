# ════════════════════════════════════════════════════════
#  AutoSense — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://autosense:yourpassword@localhost:5432/autosense

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Backend server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Email alerts (Gmail / SMTP) ───────────────────────────────────────────────
# For Gmail: enable "App Passwords" in your Google Account and use that here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
ALERT_FROM_EMAIL=your@gmail.com
ALERT_EMAIL_RECIPIENT=alerts@yourcompany.com

# ── SMS alerts (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1234567890
ALERT_SMS_RECIPIENT=+0987654321

# ── Edge AI → Backend forwarding ─────────────────────────────────────────────
# IP / port the edge-ai layer sends sensor data to
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# UDP port the C++ ECU simulator broadcasts on
UDP_LISTEN_PORT=9000

# ── Feature flags (optional) ──────────────────────────────────────────────────
# Set to "false" to disable alert channels during development
ALERTS_ENABLED=true
